{
  "name": "main-bar", // 在多显示器时设置多个bar提供标签
  "layer": "top", // top会显示在最上层
  "position": "top", // top bottom left right
  "height": 5, // 不写则动态调整
  "margin": "2, 3, 0, 3", // 边距 上 右 下 左
  "spacing": 4, // 不同模块之间的缝隙大小
  "reload_style_on_change": true, // 核心配置：开启热重载(修改css文件时不用重启)
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "custom/island"
  ],
  "modules-right": [
    "tray",
    "group/hardware2",
    "group/hardware1",
    "clock"
  ]
}
